---
import Navbar from "../components/Navbar.astro";

interface Props {
  title: string;
  currentPage?: string;
}

const { title, currentPage } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon_mochi.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | MochisArt</title>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        color: #333;
      }

      body {
        background-color: #fafafa;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      main {
        flex: 1;
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding: 3rem 2rem;
      }

      footer {
        background-color: #f5f5f5;
        text-align: center;
        padding: 2rem;
        margin-top: auto;
        border-top: 1px solid #e0e0e0;
        color: #666;
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <Navbar currentPage={currentPage} />
    <main>
      <slot />
    </main>
    <footer>© 2025 Alberto Sanchez</footer>
  </body>
</html>
