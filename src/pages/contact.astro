---
import Layout from "../layouts/Layout.astro";
import SocialLinks from "../components/SocialLinks.astro";
---

<Layout title="Contact" currentPage="/contact">
	<h1>Get in Touch</h1>
	<p class="subtitle">I'd love to hear from you. Let's connect!</p>
	
	

	<div class="contact-container">
		

		<form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
			<input type="hidden" name="access_key" value="187bfd30-a1a0-4d51-a64d-ed76fb8dc130">

			<div class="form-group">
				<label for="name">Name</label>
				<input type="text" name="name" required>
			</div>
			
			<div class="form-group">
				<label for="email">Email</label>
				<input type="email" name="email" required>
			</div>

			<div class="form-group">
				<label for="message">Message</label>
				<textarea name="message" required></textarea>
			</div>

			<div class="h-captcha" data-captcha="true"></div>

			<button type="submit" class="submit-btn">Send Message</button>
		</form>

		
		<div class="contact-info">
			<h2>Other Ways to Connect</h2>
			<div class="socials"><SocialLinks  /></div>
			<p>
				You can also reach out through social media or email me directly at 
				<a href="mailto:xmochisun@gmail.com">xmochisun@gmail.com</a>
			</p>
		</div>
	</div>
</Layout>

<style>
	h1 {
		text-align: center;
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
	}

	.subtitle {
		text-align: center;
		color: #666;
		margin-bottom: 3rem;
		font-size: 1.1rem;
	}

	.contact-container {
		max-width: 600px;
		margin: 0 auto;
	}

	.contact-form {
		background-color: #ffffffc5;
		padding: 2rem;
		border-radius: 8px;
		border: 1px solid #e0e0e0;
		margin-bottom: 2rem;
	}

	.form-group {
		margin-bottom: 1.5rem;
	}

	label {
		display: block;
		margin-bottom: 0.5rem;
		font-weight: 600;
		color: #333;
	}

	input,
	textarea {
		width: 100%;
		padding: 0.75rem;
		border: 1px solid #ddd;
		border-radius: 4px;
		font-family: inherit;
		font-size: 1rem;
		transition: border-color 0.3s ease;
	}

	input:focus,
	textarea:focus {
		outline: none;
		border-color: #000;
		box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
	}

	.submit-btn {
		background-color: #000;
		color: #fff;
		padding: 0.75rem 1.5rem;
		border: none;
		border-radius: 4px;
		font-weight: 600;
		font-size: 1rem;
		cursor: pointer;
		width: 100%;
		transition: background-color 0.3s ease;
	}

	.submit-btn:hover {
		background-color: #333;
	}

	.socials {
		justify-content: center;
		display: flex;
		gap: 1rem;
		margin-top: 1rem;
	}

	.contact-info {
		text-align: center;
		padding: 2rem;
		background-color: #f5f5f5d7;
		border-radius: 8px;
	}

	.contact-info h2 {
		font-size: 1.3rem;
		margin-bottom: 1rem;
	}

	.contact-info p {
		color: #666;
		line-height: 1.6;
	}

	.contact-info a {
		color: #000;
		text-decoration: none;
		font-weight: 600;
	}

	.contact-info a:hover {
		text-decoration: underline;
	}
</style>
<script src="https://web3forms.com/client/script.js" async defer></script>