---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About" currentPage="/about">
	<h1>About Me</h1>
	
	<div class="about-container">
		<div class="about-content">
			<p>
				Welcome to my artistic space. I'm a passionate artist dedicated to creating 
				meaningful and visually striking artwork that explores themes of identity, nature, 
				and human connection.
			</p>
			
			<h2>My Artistic Journey</h2>
			<p>
				Through my work, I strive to capture moments of beauty and emotion. Each piece 
				represents a unique exploration of color, form, and composition, blending technical 
				skill with creative vision.
			</p>
			
			<h2>What I Do</h2>
			<ul>
				<li>Original artwork and commissioned pieces</li>
				<li>Digital and traditional media</li>
				<li>Portraiture and figurative work</li>
				<li>Nature-inspired compositions</li>
			</ul>
			
			<h2>Get in Touch</h2>
			<p>
				Interested in commissioning a piece or learning more about my work? 
				<a href="/contact">Contact me</a> to discuss your project.
			</p>
		</div>
	</div>
</Layout>

<style>
	h1 {
		text-align: center;
		font-size: 2.5rem;
		margin-bottom: 2rem;
	}

	.about-container {
		max-width: 700px;
		margin: 0 auto;
	}

	.about-content {
		line-height: 1.8;
	}

	.about-content p {
		margin-bottom: 1.5rem;
		font-size: 1.05rem;
		color: #444;
	}

	.about-content h2 {
		font-size: 1.5rem;
		margin-top: 2rem;
		margin-bottom: 1rem;
		color: #000;
	}

	.about-content ul {
		list-style: none;
		padding-left: 0;
		margin-bottom: 1.5rem;
	}

	.about-content li {
		padding-left: 1.5rem;
		margin-bottom: 0.75rem;
		position: relative;
	}

	.about-content li::before {
		content: "→";
		position: absolute;
		left: 0;
		color: #000;
		font-weight: bold;
	}

	.about-content a {
		color: #000;
		text-decoration: underline;
		font-weight: 600;
		transition: color 0.3s ease;
	}

	.about-content a:hover {
		color: #666;
	}
</style>