---
import Layout from "../../layouts/Layout.astro";
import { portfolioItems, getPortfolioItem } from "../../data/portfolio";

const { id } = Astro.params;
const item = getPortfolioItem(id as string);

if (!item) {
	return Astro.redirect("/portfolio");
}

export function getStaticPaths() {
	return portfolioItems.map((item) => ({
		params: { id: item.id },
		props: { item },
	}));
}
---

<Layout title={item.title} currentPage={`/portfolio/${item.id}`}>
	<a href="/portfolio" class="back-link">← Back to Portfolio</a>

	<div class="detail-container">
		<!-- Title and Description -->
		<div class="info-section">
			<h1>{item.title}</h1>
			<p class="description">{item.description}</p>
		</div>

        <!-- Main Artwork -->
		<div class="main-artwork">
			<img src={item.finalImage} alt={item.title} />
		</div>

        <!-- Progress Photos -->
         {item.progressPhotos && (
            <div class="progress-section">
                <h2>Progress Pics</h2>
                <div class="progress-grid">
                    {item.progressPhotos.map((photo) => (
                        <img src={photo} alt="Progress photo" class="progress-photo" />
                    ))}
                </div>
		    </div>
         )}
		

		<!-- Timelapse Video (if available) -->
		{item.timelapse && (
			<div class="timelapse-section">
				<h2>Timelapse Video</h2>
				<video controls>
					<source src={item.timelapse} type="video/mp4" />
					Your browser does not support the video tag.
				</video>
			</div>
		)}

	</div>
</Layout>

<style>
	.back-link {
		display: inline-block;
		margin-bottom: 2rem;
		color: #333;
		text-decoration: none;
		font-size: 0.95rem;
		transition: color 0.3s ease;
	}

	.back-link:hover {
		color: #666;
	}

	.detail-container {
		max-width: 900px;
		margin: 0 auto;
	}

	.main-artwork {
		margin-bottom: 2rem;
		border-radius: 8px;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #f0f0f0;
	}

	.main-artwork img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.info-section {
		margin-bottom: 1rem;
		padding: 2rem;
		background-color: #f9f9f9e8;
		border-radius: 8px;
	}

	.info-section h1 {
		margin-top: 0;
		margin-bottom: 1rem;
		font-size: 2rem;
	}

	.description {
		font-size: 1rem;
		line-height: 1.6;
		color: #555;
		margin: 0;
	}

	.timelapse-section {
		margin-bottom: 3rem;
	}

	.timelapse-section h2 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
	}

	.timelapse-section video {
		width: 100%;
		border-radius: 8px;
		background-color: #000;
	}

	.progress-section {
		margin-bottom: 2rem;
	}

	.progress-section h2 {
		font-size: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.progress-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1rem;
	}

	.progress-photo {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 8px;
		cursor: pointer;
		transition: transform 0.3s ease;
	}

	.progress-photo:hover {
		transform: scale(1.05);
	}
</style>
