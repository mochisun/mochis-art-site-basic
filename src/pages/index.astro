---
import SocialLinks from "../components/SocialLinks.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home" currentPage="/">
	<div class="hero">
		<img src="/avatar/mochi_pfp.PNG" alt="Mochi Art Logo" class="logo" />
		<p>Welcome to my self-coded Art Website! You can find me on any of the socials below or checkout the gallery to see high resolution images of my art :)</p>
		<div class="hero-buttons">
 			<!-- <a href="/portfolio" class="button button-primary">View Portfolio</a> -->
			<a href="/gallery" class="button button-secondary">Browse Gallery</a>
		</div>
		<div class="socials"><SocialLinks  /></div>
	</div>
</Layout>

<style>
	
	.hero {
		text-align: center;
		padding: .5rem 2rem;
	}

	.hero h1 {
		font-size: 3rem;
		margin-bottom: 1rem;
		color: #000;
	}

	.hero p {
		font-size: 1.25rem;
		color: #666;
		margin-bottom: 2rem;
	}

	.hero-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.button {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		border-radius: 4px;
		text-decoration: none;
		font-weight: 600;
		transition: all 0.3s ease;
		border: 2px solid;
		cursor: pointer;
	}

	.button-primary {
		background-color: #000;
		color: #fff;
		border-color: #000;
	}

	.button-primary:hover {
		background-color: #333;
		border-color: #333;
	}

	.button-secondary {
		background-color: transparent;
		color: #000;
		border-color: #000;
	}

	.button-secondary:hover {
		background-color: #f0f0f0;
	}
	
	.logo {
		width: 200px;
		height: 200px;
		border-radius: 50%;
		margin-bottom: 2rem;
		object-fit: cover;
	}

	.socials {
		justify-content: center;
		display: flex;
		gap: 1rem;
		margin-top: 2rem;
	}

	@media (max-width: 768px) {
		.hero h1 {
			font-size: 2rem;
		}

		.hero p {
			font-size: 1rem;
		}
	}
</style>
