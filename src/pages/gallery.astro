---
import Layout from "../layouts/Layout.astro";
import { getGalleryData, getAllYears } from "../data/gallery";

const galleryData = getGalleryData();
const allYears = getAllYears();
---

<Layout title="Gallery" currentPage="/gallery">
	<h1>Digital Art Gallery</h1>
	<p class="subtitle">Browse my digital pieces from the past few years</p>

	<!-- Year Filter Bar -->
	<div class="year-bar">
		<button class="year-btn active" data-year="all">All Years</button>
		{allYears.map((year) => (
			<button class="year-btn" data-year={year}>
				{year}
			</button>
		))}
	</div>

	<!-- Gallery Grid -->
	<div class="gallery-grid" id="gallery-grid">
		{galleryData.map((yearData) =>
			yearData.images.map((image, index) => (
				<div
					class="gallery-item"
					data-year={yearData.year}
					data-image-path={image.imagePath}
					data-image-index={index}
				>
					<img
						src={image.imagePath}
						alt={image.filename}
						loading="lazy"
					/>
				</div>
			))
		)}
	</div>

	<!-- Lightbox Modal -->
	<div id="lightbox" class="lightbox">
		<div class="lightbox-content">
			<button class="lightbox-close">✕</button>
			<img id="lightbox-image" src="" alt="Enlarged view" />
		</div>
	</div>
</Layout>

<style>
	h1 {
		text-align: center;
		margin-bottom: 0.5rem;
		font-size: 2.5rem;
	}

	.subtitle {
		text-align: center;
		color: #666;
		margin-bottom: 2rem;
		font-size: 1.1rem;
	}

	.year-bar {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 3rem;
		flex-wrap: wrap;
	}

	.year-btn {
		padding: 0.75rem 1.5rem;
		border: 2px solid #ddd;
		background-color: #ffffffd3;
		border-radius: 25px;
		cursor: pointer;
		font-size: 0.95rem;
		transition: all 0.3s ease;
		color: #333;
	}

	.year-btn:hover {
		border-color: #999;
		background-color: #f5f5f5;
	}

	.year-btn.active {
		background-color: #333333b4;
		color: #fff;
		border-color: #333;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.gallery-item {
		transition: transform 0.3s ease, opacity 0.3s ease;
		cursor: pointer;
		overflow: hidden;
		border-radius: 8px;
		aspect-ratio: 1;
		background-color: #f0f0f0;
	}

	.gallery-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.gallery-item:hover img {
		transform: scale(1.05);
	}

	.gallery-item.hidden {
		display: none;
	}

	.lightbox {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.9);
		z-index: 1000;
		align-items: center;
		justify-content: center;
		backdrop-filter: blur(5px);
	}

	.lightbox.active {
		display: flex;
	}

	.lightbox-content {
		position: relative;
		max-width: 40%;
		max-height: 40%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	#lightbox-image {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		border-radius: 8px;
	}

	.lightbox-close {
		position: absolute;
		top: 0px;
		right: -75px;
		background-color: rgba(255, 255, 255, 0.438);
		color: rgba(0, 0, 0, 0.507);
		font-size: 2rem;
		cursor: pointer;
		padding: 10px 15px;
		border-radius: 4px;
		border-color: #00000085;
		border-radius: 25%;
		transition: background-color 0.3s ease;
		z-index: 1001;
	}

	.lightbox-close:hover {
		background-color: rgba(255, 255, 255, 0.4);
	}
</style>

<script>
	//Telling TS HTML elements exist
	const lightbox = document.getElementById("lightbox") as HTMLImageElement;
	const lightboxImage = document.getElementById("lightbox-image") as HTMLImageElement;
	const lightboxClose = document.querySelector(".lightbox-close") as HTMLImageElement;
	const galleryItems = document.querySelectorAll(".gallery-item");
	const yearBtns = document.querySelectorAll(".year-btn");

	// Lightbox functionality
	galleryItems.forEach((item) => {
		item.addEventListener("click", () => {
			const imagePath = item.getAttribute("data-image-path") as string;
			lightboxImage.src =  imagePath;
			lightbox.classList.add("active");
		});
	});

	lightboxClose.addEventListener("click", () => {
		lightbox.classList.remove("active");
	});

	lightbox.addEventListener("click", (e) => {
		if (e.target === lightbox) {
			lightbox.classList.remove("active");
		}
	});

	// Year filter functionality
	yearBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			yearBtns.forEach((b) => b.classList.remove("active"));
			btn.classList.add("active");

			const selectedYear = btn.getAttribute("data-year");
			galleryItems.forEach((item) => {
				if (selectedYear === "all" || item.getAttribute("data-year") === selectedYear) {
					item.classList.remove("hidden");
				} else {
					item.classList.add("hidden");
				}
			});
		});
	});
</script>